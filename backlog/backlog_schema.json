{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MovePal product backlog",
  "type": "object",
  "required": [
    "project",
    "organization",
    "repository",
    "tasks"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "position",
          "title",
          "value",
          "description",
          "beginner_learning_objective",
          "deliverables",
          "acceptance_criteria",
          "definition_of_done",
          "dependencies",
          "blocking_status",
          "workstream",
          "suggested_scrum_role",
          "team",
          "estimated_focused_work_hours",
          "investigation_buffer_hours",
          "review_buffer_hours",
          "qa_buffer_hours",
          "priority",
          "sprint_designation",
          "github_labels",
          "milestone",
          "project_status",
          "risks",
          "helpful_references",
          "pull_request_required",
          "suggested_test_requirements",
          "security_privacy_considerations",
          "demo_evidence_required",
          "manual_testing_only",
          "issue_body",
          "required_reading",
          "practical_output",
          "dependency_rationale",
          "preparation_learning_hours",
          "implementation_hours",
          "testing_hours",
          "handoff_to"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^MP-[0-9]{3}$"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "primary_assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_focused_work_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sprint_designation": {
            "enum": [
              "sprint-1",
              "post-sprint",
              "future",
              "optional"
            ]
          },
          "manual_testing_only": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effort_allocation_hours": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "required_reading": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "practical_output": {
            "type": "string",
            "minLength": 5
          },
          "dependency_rationale": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "preparation_learning_hours": {
            "type": "number",
            "minimum": 0
          },
          "implementation_hours": {
            "type": "number",
            "minimum": 0
          },
          "testing_hours": {
            "type": "number",
            "minimum": 0
          },
          "handoff_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
