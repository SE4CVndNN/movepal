# Entry point Flask loads when running `flask run`
FLASK_APP=run.py

# Keep at 0 locally; only enable Flask debug mode temporarily and never in CI or shared demos
FLASK_DEBUG=0

# Local-only development secret; replace with any random string, never reuse a real credential
SECRET_KEY=replace-with-a-local-development-value

# Maximum accepted upload size in megabytes for camera frames / fallback samples
MAX_CONTENT_LENGTH_MB=5